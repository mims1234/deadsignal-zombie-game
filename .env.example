# Copy to .env on the server and fill in. Never commit .env.

# The address players open, with no trailing slash. Sign-in cookies are marked secure when this is https.
PUBLIC_URL=https://zombies.genxmims.org

# Discord application (https://discord.com/developers/applications -> OAuth2).
# Add this redirect there:  <PUBLIC_URL>/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Discord user ids with access to /admin, comma separated.
ADMIN_IDS=292675388180791297

PORT=3061
# Where the SQLite database lives (created on first start). Back this folder up.
DATA_DIR=./data

# Local development only: DEV_LOGIN=1 adds /auth/dev, a sign-in that skips Discord. Ignored when PUBLIC_URL is https.
