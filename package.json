{
  "name": "dead-signal-exclusion-zone",
  "private": true,
  "version": "1.0.0",
  "description": "DEAD SIGNAL: EXCLUSION ZONE - the Sonnet 5.5 Zombies Game, a single-player extraction-survival FPS built with Three.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bridge-mind/sonnet-5-5-zombies-game.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "build": "tsc --noEmit && vite build && vite build -c vite.sim.config.ts",
    "build:sim": "vite build -c vite.sim.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.6",
    "@pixiv/three-vrm": "^3.5.5",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.5",
    "three": "0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "22",
    "@types/three": "0.186.0",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
